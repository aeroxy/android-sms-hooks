<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls, so the button stays reachable on short screens (landscape, split screen). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mantis"
    android:fillViewport="true"
    tools:context=".PermissionsEduFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/drawable"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/img_alt_notify"
            android:src="@drawable/ic_notify" />

        <TextView
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal"
            android:text="@string/title_sms_permission_edu"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:text="@string/text_sms_permission_edu"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/tryAgainButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/btn_request_permissions"
            android:textColor="@color/black"
            app:backgroundTint="@color/white" />
    </LinearLayout>
</ScrollView>
